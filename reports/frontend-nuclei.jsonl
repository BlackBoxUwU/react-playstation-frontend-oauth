{"template":"http/misconfiguration/http-missing-security-headers.yaml","template-url":"https://cloud.projectdiscovery.io/public/http-missing-security-headers","template-id":"http-missing-security-headers","template-path":"/root/nuclei-templates/http/misconfiguration/http-missing-security-headers.yaml","info":{"name":"HTTP Missing Security Headers","author":["socketz","geeknik","g4l1t0","convisoappsec","kurohost","dawid-czarnecki","forgedhallpass","jub0bs","userdehghani","celbahraoui","safejulian"],"tags":["misconfig","headers","generic","vuln"],"description":"This template searches for missing HTTP security headers. The impact of these missing headers can vary.\n","severity":"info","metadata":{"max-request":1},"classification":{"cve-id":null,"cwe-id":["cwe-693"]}},"matcher-name":"strict-transport-security","type":"http","host":"frontend","port":"80","scheme":"http","url":"http://frontend:80","matched-at":"http://frontend:80","request":"GET / HTTP/1.1\r\nHost: frontend\r\nUser-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:70.0) Gecko/20100101 Firefox/70.0\r\nAccept: */*\r\nAccept-Language: en\r\nAccept-Encoding: gzip\r\n\r\n","response":"HTTP/1.1 200 OK\r\nContent-Length: 9928\r\nAccept-Ranges: bytes\r\nConnection: keep-alive\r\nContent-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'\r\nContent-Type: text/html\r\nCross-Origin-Embedder-Policy: require-corp\r\nCross-Origin-Opener-Policy: same-origin\r\nCross-Origin-Resource-Policy: same-origin\r\nDate: Thu, 15 Oct 2026 23:35:54 GMT\r\nEtag: \"6ad161f1-26c8\"\r\nLast-Modified: Thu, 15 Oct 2026 23:29:53 GMT\r\nPermissions-Policy: camera=(), microphone=(), geolocation=()\r\nReferrer-Policy: no-referrer\r\nServer: nginx\r\nX-Content-Type-Options: nosniff\r\nX-Frame-Options: DENY\r\nX-Permitted-Cross-Domain-Policies: none\r\n\r\n\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n  \u003cmeta charset=\"UTF-8\" /\u003e\n  \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" /\u003e\n  \u003ctitle\u003eCybersecurity Portal: LDAP Authentication \u0026 Hot Secret Rotation\u003c/title\u003e\n  \u003clink rel=\"stylesheet\" href=\"styles.css\" /\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n  \u003cdiv class=\"app-container\"\u003e\n\n    \u003c!-- TOP HEADER --\u003e\n    \u003cheader class=\"header\"\u003e\n      \u003cdiv class=\"header-content\"\u003e\n        \u003cdiv class=\"logo-area\"\u003e\n          \u003cdiv class=\"shield-icon\"\u003e🛡️\u003c/div\u003e\n          \u003cdiv\u003e\n            \u003ch1\u003eSecurity Control \u0026 Secret Rotation Portal\u003c/h1\u003e\n            \u003cp class=\"subtitle\"\u003eOpenLDAP Authentication + 3-Service Dynamic Key Rotation + AES-256 DB Encryption\u003c/p\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"header-right\"\u003e\n          \u003cdiv class=\"status-badge\" id=\"serviceStatus\"\u003e\n            \u003cspan class=\"status-dot\"\u003e\u003c/span\u003e\n            \u003cspan id=\"statusText\"\u003eConnecting...\u003c/span\u003e\n          \u003c/div\u003e\n          \u003cdiv id=\"userProfileBadge\" class=\"user-badge hidden\"\u003e\n            \u003cspan class=\"user-avatar\"\u003e👤\u003c/span\u003e\n            \u003cdiv class=\"user-info\"\u003e\n              \u003cstrong id=\"userDisplayName\"\u003eAlice Smith\u003c/strong\u003e\n              \u003cspan id=\"userDn\"\u003euid=alice,ou=users\u003c/span\u003e\n            \u003c/div\u003e\n            \u003cbutton id=\"btnLogout\" class=\"btn-logout\" title=\"Log Out\"\u003eLogout\u003c/button\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/header\u003e\n\n    \u003c!-- VIEW 1: LANDING PAGE (LOGIN) --\u003e\n    \u003csection id=\"loginView\" class=\"view-section active\"\u003e\n      \u003cdiv class=\"login-wrapper\"\u003e\n        \u003cdiv class=\"login-card\"\u003e\n          \u003cdiv class=\"login-header\"\u003e\n            \u003cdiv class=\"lock-icon\"\u003e🔐\u003c/div\u003e\n            \u003ch2\u003eEnterprise LDAP Authentication\u003c/h2\u003e\n            \u003cp\u003eEnter your corporate LDAP directory credentials to access the secure control center.\u003c/p\u003e\n          \u003c/div\u003e\n\n          \u003cdiv class=\"auth-notice\"\u003e\n            \u003cspan class=\"notice-icon\"\u003e💡\u003c/span\u003e\n            \u003cdiv\u003e\n              \u003cstrong\u003eQuick Demo Credentials:\u003c/strong\u003e\n              \u003cdiv class=\"quick-credentials\"\u003e\n                \u003cbutton type=\"button\" class=\"btn-fill-creds\" data-user=\"alice\" data-pass=\"alice123\"\u003e\n                  User: \u003ccode\u003ealice\u003c/code\u003e / \u003ccode\u003ealice123\u003c/code\u003e\n                \u003c/button\u003e\n                \u003cbutton type=\"button\" class=\"btn-fill-creds\" data-user=\"bob\" data-pass=\"bob123\"\u003e\n                  User: \u003ccode\u003ebob\u003c/code\u003e / \u003ccode\u003ebob123\u003c/code\u003e\n                \u003c/button\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n\n          \u003cform id=\"loginForm\" class=\"login-form\"\u003e\n            \u003cdiv class=\"form-group\"\u003e\n              \u003clabel for=\"usernameInput\"\u003eLDAP Username (UID)\u003c/label\u003e\n              \u003cdiv class=\"input-icon-wrapper\"\u003e\n                \u003cspan class=\"input-icon\"\u003e👤\u003c/span\u003e\n                \u003cinput type=\"text\" id=\"usernameInput\" placeholder=\"e.g., alice or bob\" required autocomplete=\"username\" /\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003cdiv class=\"form-group\"\u003e\n              \u003clabel for=\"passwordInput\"\u003ePassword\u003c/label\u003e\n              \u003cdiv class=\"input-icon-wrapper\"\u003e\n                \u003cspan class=\"input-icon\"\u003e🔑\u003c/span\u003e\n                \u003cinput type=\"password\" id=\"passwordInput\" placeholder=\"••••••••\" required autocomplete=\"current-password\" /\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003cdiv id=\"loginFeedback\" class=\"feedback-box hidden\"\u003e\u003c/div\u003e\n\n            \u003cbutton type=\"submit\" id=\"btnLoginSubmit\" class=\"btn btn-primary btn-block\"\u003e\n              \u003cspan class=\"btn-icon\"\u003e⚡\u003c/span\u003e Authenticate via LDAP\n            \u003c/button\u003e\n          \u003c/form\u003e\n\n          \u003cdiv class=\"login-footer\"\u003e\n            \u003cspan\u003e🔒 Request proxied via NGINX with injected dynamic \u003ccode\u003ex-api-key\u003c/code\u003e to LDAP container (:8000).\u003c/span\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/section\u003e\n\n    \u003c!-- VIEW 2: MAIN DASHBOARD (PROTECTED) --\u003e\n    \u003csection id=\"dashboardView\" class=\"view-section hidden\"\u003e\n      \n      \u003c!-- Multi-Service Architecture Overview Banner --\u003e\n      \u003csection class=\"architecture-card\"\u003e\n        \u003cdiv class=\"arch-col\"\u003e\n          \u003cdiv class=\"arch-pill rotate-pill\"\u003e\n            \u003cspan class=\"pill-icon\"\u003e🔄\u003c/span\u003e\n            \u003cdiv class=\"pill-text\"\u003e\n              \u003cstrong\u003eRotator Daemon\u003c/strong\u003e\n              \u003cspan\u003eUpdates secret every 2m in hot-reload\u003c/span\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"arch-arrow\"\u003e➔\u003c/div\u003e\n        \u003cdiv class=\"arch-col\"\u003e\n          \u003cdiv class=\"arch-pill proxy-pill\"\u003e\n            \u003cspan class=\"pill-icon\"\u003e🌐\u003c/span\u003e\n            \u003cdiv class=\"pill-text\"\u003e\n              \u003cstrong\u003eFrontend NGINX (:8080)\u003c/strong\u003e\n              \u003cspan\u003eInjects dynamic x-api-key\u003c/span\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"arch-arrow\"\u003e➔\u003c/div\u003e\n        \u003cdiv class=\"arch-col\"\u003e\n          \u003cdiv class=\"arch-pill backend-pill\"\u003e\n            \u003cspan class=\"pill-icon\"\u003e⚙️\u003c/span\u003e\n            \u003cdiv class=\"pill-text\"\u003e\n              \u003cstrong\u003eBackend API (:3000)\u003c/strong\u003e\n              \u003cspan\u003eAES-256 DB \u0026 Protected Data\u003c/span\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"arch-arrow\"\u003e+\u003c/div\u003e\n        \u003cdiv class=\"arch-col\"\u003e\n          \u003cdiv class=\"arch-pill ldap-pill\"\u003e\n            \u003cspan class=\"pill-icon\"\u003e🏢\u003c/span\u003e\n            \u003cdiv class=\"pill-text\"\u003e\n              \u003cstrong\u003eLDAP Service (:8000)\u003c/strong\u003e\n              \u003cspan\u003eAuth \u0026 Directory Validation\u003c/span\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/section\u003e\n\n      \u003cmain class=\"grid-main\"\u003e\n        \u003c!-- Left Column: Operations --\u003e\n        \u003cdiv class=\"col-operations\"\u003e\n          \n          \u003c!-- Card 1: 3-Service Rotation Verification --\u003e\n          \u003csection class=\"card\"\u003e\n            \u003cdiv class=\"card-header\"\u003e\n              \u003cspan class=\"card-tag\"\u003e3-Service Verification\u003c/span\u003e\n              \u003ch2\u003e1. Secret Rotation Diagnostics\u003c/h2\u003e\n            \u003c/div\u003e\n            \u003cp class=\"card-desc\"\u003e\n              Validate that the exact same rotated \u003ccode\u003eAPI_SECRET\u003c/code\u003e is actively protecting both the \u003cstrong\u003eBackend API\u003c/strong\u003e and the \u003cstrong\u003eLDAP Service\u003c/strong\u003e without restarting either container.\n            \u003c/p\u003e\n\n            \u003cdiv class=\"btn-grid\"\u003e\n              \u003cbutton id=\"btnGetBackendStatus\" class=\"btn btn-outline\"\u003e\n                \u003cspan class=\"btn-icon\"\u003e🔍\u003c/span\u003e Backend Secret (:3000)\n              \u003c/button\u003e\n              \u003cbutton id=\"btnGetLdapStatus\" class=\"btn btn-outline\"\u003e\n                \u003cspan class=\"btn-icon\"\u003e🏢\u003c/span\u003e LDAP Secret (:8000)\n              \u003c/button\u003e\n              \u003cbutton id=\"btnGetData\" class=\"btn btn-primary\"\u003e\n                \u003cspan class=\"btn-icon\"\u003e⚡\u003c/span\u003e GET /api/data\n              \u003c/button\u003e\n              \u003cbutton id=\"btnPostData\" class=\"btn btn-secondary\"\u003e\n                \u003cspan class=\"btn-icon\"\u003e📤\u003c/span\u003e POST /api/data\n              \u003c/button\u003e\n            \u003c/div\u003e\n          \u003c/section\u003e\n\n          \u003c!-- Card 2: Encrypted Database (AES-256) --\u003e\n          \u003csection class=\"card\"\u003e\n            \u003cdiv class=\"card-header\"\u003e\n              \u003cspan class=\"card-tag\"\u003eStatic Encryption\u003c/span\u003e\n              \u003ch2\u003e2. Encrypted Database (AES-256)\u003c/h2\u003e\n            \u003c/div\u003e\n            \u003cp class=\"card-desc\"\u003e\n              Sensitive items are encrypted with \u003ccode\u003eDATABASE_ENCRYPTION_KEY\u003c/code\u003e (which remains permanently static and un-rotated) before writing to disk.\n            \u003c/p\u003e\n\n            \u003cform id=\"encryptForm\" class=\"form-encrypt\"\u003e\n              \u003cdiv class=\"input-group\"\u003e\n                \u003clabel for=\"itemTitle\"\u003eRecord Title / Identifier\u003c/label\u003e\n                \u003cinput type=\"text\" id=\"itemTitle\" placeholder=\"e.g., VPN Credential, Secret Key, Token...\" required /\u003e\n              \u003c/div\u003e\n              \u003cdiv class=\"input-group\"\u003e\n                \u003clabel for=\"itemContent\"\u003eConfidential Payload to Encrypt\u003c/label\u003e\n                \u003ctextarea id=\"itemContent\" rows=\"2\" placeholder=\"e.g., Sensitive payload to store encrypted in DB...\" required\u003e\u003c/textarea\u003e\n              \u003c/div\u003e\n              \u003cdiv class=\"btn-group\"\u003e\n                \u003cbutton type=\"submit\" id=\"btnSaveEncrypted\" class=\"btn btn-accent\"\u003e\n                  \u003cspan class=\"btn-icon\"\u003e🔐\u003c/span\u003e Encrypt \u0026 Store in DB\n                \u003c/button\u003e\n                \u003cbutton type=\"button\" id=\"btnLoadRecords\" class=\"btn btn-outline\"\u003e\n                  \u003cspan class=\"btn-icon\"\u003e📋\u003c/span\u003e Retrieve \u0026 Decrypt Records\n                \u003c/button\u003e\n              \u003c/div\u003e\n            \u003c/form\u003e\n          \u003c/section\u003e\n\n        \u003c/div\u003e\n\n        \u003c!-- Right Column: Live Console \u0026 Decrypted Records --\u003e\n        \u003cdiv class=\"col-console\"\u003e\n          \u003c!-- Terminal / Response viewer --\u003e\n          \u003csection class=\"card console-card\"\u003e\n            \u003cdiv class=\"console-header\"\u003e\n              \u003cdiv class=\"console-dots\"\u003e\n                \u003cspan class=\"dot red\"\u003e\u003c/span\u003e\n                \u003cspan class=\"dot yellow\"\u003e\u003c/span\u003e\n                \u003cspan class=\"dot green\"\u003e\u003c/span\u003e\n              \u003c/div\u003e\n              \u003cspan class=\"console-title\"\u003eLive HTTP Interceptor Console\u003c/span\u003e\n              \u003cbutton id=\"btnClearConsole\" class=\"btn-clear\" title=\"Clear Console\"\u003eClear\u003c/button\u003e\n            \u003c/div\u003e\n            \u003cdiv class=\"console-body\" id=\"consoleOutput\"\u003e\n              \u003cpre\u003e\u003ccode class=\"language-json\"\u003e// Welcome! Authentication successful via LDAP.\n// Click any endpoint button to test real-time requests through NGINX...\u003c/code\u003e\u003c/pre\u003e\n            \u003c/div\u003e\n          \u003c/section\u003e\n\n          \u003c!-- Stored Records Display --\u003e\n          \u003csection class=\"card records-card\"\u003e\n            \u003cdiv class=\"card-header\"\u003e\n              \u003ch2\u003eDecrypted Database Records\u003c/h2\u003e\n              \u003cspan class=\"badge\" id=\"recordCount\"\u003e0 records\u003c/span\u003e\n            \u003c/div\u003e\n            \u003cdiv class=\"records-container\" id=\"recordsList\"\u003e\n              \u003cp class=\"empty-state\"\u003eNo records loaded yet. Click \"Retrieve \u0026 Decrypt Records\".\u003c/p\u003e\n            \u003c/div\u003e\n          \u003c/section\u003e\n        \u003c/div\u003e\n      \u003c/main\u003e\n\n    \u003c/section\u003e\n\n    \u003c!-- FOOTER --\u003e\n    \u003cfooter class=\"footer\"\u003e\n      \u003cp\u003eCybersecurity Lab — LDAP Auth, Zero-Downtime Secret Rotation \u0026 AES-256 Encryption Demo\u003c/p\u003e\n    \u003c/footer\u003e\n\n  \u003c/div\u003e\n\n  \u003cscript src=\"app.js\"\u003e\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n","ip":"172.25.0.6","timestamp":"2026-10-15T23:35:54.527821566Z","curl-command":"curl -X 'GET' -d '' -H 'Accept: */*' -H 'Accept-Language: en' -H 'User-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:70.0) Gecko/20100101 Firefox/70.0' 'http://frontend:80'","matcher-status":true}
{"template":"http/miscellaneous/form-detection.yaml","template-url":"https://cloud.projectdiscovery.io/public/form-detection","template-id":"form-detection","template-path":"/root/nuclei-templates/http/miscellaneous/form-detection.yaml","info":{"name":"Form Detection","author":["pdteam"],"tags":["form","misc","miscellaneous","vuln"],"description":"A template to detect HTML Forms in page response.\n","reference":["https://github.com/dirtycoder0124/formcrawler"],"severity":"info","metadata":{"max-request":1}},"type":"http","host":"frontend","port":"80","scheme":"http","url":"http://frontend:80","matched-at":"http://frontend:80","request":"GET / HTTP/1.1\r\nHost: frontend\r\nUser-Agent: Mozilla/5.0 (Knoppix; Linux i686) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36\r\nAccept: */*\r\nAccept-Language: en\r\nAccept-Encoding: gzip\r\n\r\n","response":"HTTP/1.1 200 OK\r\nContent-Length: 9928\r\nAccept-Ranges: bytes\r\nConnection: keep-alive\r\nContent-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'\r\nContent-Type: text/html\r\nCross-Origin-Embedder-Policy: require-corp\r\nCross-Origin-Opener-Policy: same-origin\r\nCross-Origin-Resource-Policy: same-origin\r\nDate: Thu, 15 Oct 2026 23:36:01 GMT\r\nEtag: \"6ad161f1-26c8\"\r\nLast-Modified: Thu, 15 Oct 2026 23:29:53 GMT\r\nPermissions-Policy: camera=(), microphone=(), geolocation=()\r\nReferrer-Policy: no-referrer\r\nServer: nginx\r\nX-Content-Type-Options: nosniff\r\nX-Frame-Options: DENY\r\nX-Permitted-Cross-Domain-Policies: none\r\n\r\n\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n  \u003cmeta charset=\"UTF-8\" /\u003e\n  \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" /\u003e\n  \u003ctitle\u003eCybersecurity Portal: LDAP Authentication \u0026 Hot Secret Rotation\u003c/title\u003e\n  \u003clink rel=\"stylesheet\" href=\"styles.css\" /\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n  \u003cdiv class=\"app-container\"\u003e\n\n    \u003c!-- TOP HEADER --\u003e\n    \u003cheader class=\"header\"\u003e\n      \u003cdiv class=\"header-content\"\u003e\n        \u003cdiv class=\"logo-area\"\u003e\n          \u003cdiv class=\"shield-icon\"\u003e🛡️\u003c/div\u003e\n          \u003cdiv\u003e\n            \u003ch1\u003eSecurity Control \u0026 Secret Rotation Portal\u003c/h1\u003e\n            \u003cp class=\"subtitle\"\u003eOpenLDAP Authentication + 3-Service Dynamic Key Rotation + AES-256 DB Encryption\u003c/p\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"header-right\"\u003e\n          \u003cdiv class=\"status-badge\" id=\"serviceStatus\"\u003e\n            \u003cspan class=\"status-dot\"\u003e\u003c/span\u003e\n            \u003cspan id=\"statusText\"\u003eConnecting...\u003c/span\u003e\n          \u003c/div\u003e\n          \u003cdiv id=\"userProfileBadge\" class=\"user-badge hidden\"\u003e\n            \u003cspan class=\"user-avatar\"\u003e👤\u003c/span\u003e\n            \u003cdiv class=\"user-info\"\u003e\n              \u003cstrong id=\"userDisplayName\"\u003eAlice Smith\u003c/strong\u003e\n              \u003cspan id=\"userDn\"\u003euid=alice,ou=users\u003c/span\u003e\n            \u003c/div\u003e\n            \u003cbutton id=\"btnLogout\" class=\"btn-logout\" title=\"Log Out\"\u003eLogout\u003c/button\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/header\u003e\n\n    \u003c!-- VIEW 1: LANDING PAGE (LOGIN) --\u003e\n    \u003csection id=\"loginView\" class=\"view-section active\"\u003e\n      \u003cdiv class=\"login-wrapper\"\u003e\n        \u003cdiv class=\"login-card\"\u003e\n          \u003cdiv class=\"login-header\"\u003e\n            \u003cdiv class=\"lock-icon\"\u003e🔐\u003c/div\u003e\n            \u003ch2\u003eEnterprise LDAP Authentication\u003c/h2\u003e\n            \u003cp\u003eEnter your corporate LDAP directory credentials to access the secure control center.\u003c/p\u003e\n          \u003c/div\u003e\n\n          \u003cdiv class=\"auth-notice\"\u003e\n            \u003cspan class=\"notice-icon\"\u003e💡\u003c/span\u003e\n            \u003cdiv\u003e\n              \u003cstrong\u003eQuick Demo Credentials:\u003c/strong\u003e\n              \u003cdiv class=\"quick-credentials\"\u003e\n                \u003cbutton type=\"button\" class=\"btn-fill-creds\" data-user=\"alice\" data-pass=\"alice123\"\u003e\n                  User: \u003ccode\u003ealice\u003c/code\u003e / \u003ccode\u003ealice123\u003c/code\u003e\n                \u003c/button\u003e\n                \u003cbutton type=\"button\" class=\"btn-fill-creds\" data-user=\"bob\" data-pass=\"bob123\"\u003e\n                  User: \u003ccode\u003ebob\u003c/code\u003e / \u003ccode\u003ebob123\u003c/code\u003e\n                \u003c/button\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n\n          \u003cform id=\"loginForm\" class=\"login-form\"\u003e\n            \u003cdiv class=\"form-group\"\u003e\n              \u003clabel for=\"usernameInput\"\u003eLDAP Username (UID)\u003c/label\u003e\n              \u003cdiv class=\"input-icon-wrapper\"\u003e\n                \u003cspan class=\"input-icon\"\u003e👤\u003c/span\u003e\n                \u003cinput type=\"text\" id=\"usernameInput\" placeholder=\"e.g., alice or bob\" required autocomplete=\"username\" /\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003cdiv class=\"form-group\"\u003e\n              \u003clabel for=\"passwordInput\"\u003ePassword\u003c/label\u003e\n              \u003cdiv class=\"input-icon-wrapper\"\u003e\n                \u003cspan class=\"input-icon\"\u003e🔑\u003c/span\u003e\n                \u003cinput type=\"password\" id=\"passwordInput\" placeholder=\"••••••••\" required autocomplete=\"current-password\" /\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003cdiv id=\"loginFeedback\" class=\"feedback-box hidden\"\u003e\u003c/div\u003e\n\n            \u003cbutton type=\"submit\" id=\"btnLoginSubmit\" class=\"btn btn-primary btn-block\"\u003e\n              \u003cspan class=\"btn-icon\"\u003e⚡\u003c/span\u003e Authenticate via LDAP\n            \u003c/button\u003e\n          \u003c/form\u003e\n\n          \u003cdiv class=\"login-footer\"\u003e\n            \u003cspan\u003e🔒 Request proxied via NGINX with injected dynamic \u003ccode\u003ex-api-key\u003c/code\u003e to LDAP container (:8000).\u003c/span\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/section\u003e\n\n    \u003c!-- VIEW 2: MAIN DASHBOARD (PROTECTED) --\u003e\n    \u003csection id=\"dashboardView\" class=\"view-section hidden\"\u003e\n      \n      \u003c!-- Multi-Service Architecture Overview Banner --\u003e\n      \u003csection class=\"architecture-card\"\u003e\n        \u003cdiv class=\"arch-col\"\u003e\n          \u003cdiv class=\"arch-pill rotate-pill\"\u003e\n            \u003cspan class=\"pill-icon\"\u003e🔄\u003c/span\u003e\n            \u003cdiv class=\"pill-text\"\u003e\n              \u003cstrong\u003eRotator Daemon\u003c/strong\u003e\n              \u003cspan\u003eUpdates secret every 2m in hot-reload\u003c/span\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"arch-arrow\"\u003e➔\u003c/div\u003e\n        \u003cdiv class=\"arch-col\"\u003e\n          \u003cdiv class=\"arch-pill proxy-pill\"\u003e\n            \u003cspan class=\"pill-icon\"\u003e🌐\u003c/span\u003e\n            \u003cdiv class=\"pill-text\"\u003e\n              \u003cstrong\u003eFrontend NGINX (:8080)\u003c/strong\u003e\n              \u003cspan\u003eInjects dynamic x-api-key\u003c/span\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"arch-arrow\"\u003e➔\u003c/div\u003e\n        \u003cdiv class=\"arch-col\"\u003e\n          \u003cdiv class=\"arch-pill backend-pill\"\u003e\n            \u003cspan class=\"pill-icon\"\u003e⚙️\u003c/span\u003e\n            \u003cdiv class=\"pill-text\"\u003e\n              \u003cstrong\u003eBackend API (:3000)\u003c/strong\u003e\n              \u003cspan\u003eAES-256 DB \u0026 Protected Data\u003c/span\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"arch-arrow\"\u003e+\u003c/div\u003e\n        \u003cdiv class=\"arch-col\"\u003e\n          \u003cdiv class=\"arch-pill ldap-pill\"\u003e\n            \u003cspan class=\"pill-icon\"\u003e🏢\u003c/span\u003e\n            \u003cdiv class=\"pill-text\"\u003e\n              \u003cstrong\u003eLDAP Service (:8000)\u003c/strong\u003e\n              \u003cspan\u003eAuth \u0026 Directory Validation\u003c/span\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/section\u003e\n\n      \u003cmain class=\"grid-main\"\u003e\n        \u003c!-- Left Column: Operations --\u003e\n        \u003cdiv class=\"col-operations\"\u003e\n          \n          \u003c!-- Card 1: 3-Service Rotation Verification --\u003e\n          \u003csection class=\"card\"\u003e\n            \u003cdiv class=\"card-header\"\u003e\n              \u003cspan class=\"card-tag\"\u003e3-Service Verification\u003c/span\u003e\n              \u003ch2\u003e1. Secret Rotation Diagnostics\u003c/h2\u003e\n            \u003c/div\u003e\n            \u003cp class=\"card-desc\"\u003e\n              Validate that the exact same rotated \u003ccode\u003eAPI_SECRET\u003c/code\u003e is actively protecting both the \u003cstrong\u003eBackend API\u003c/strong\u003e and the \u003cstrong\u003eLDAP Service\u003c/strong\u003e without restarting either container.\n            \u003c/p\u003e\n\n            \u003cdiv class=\"btn-grid\"\u003e\n              \u003cbutton id=\"btnGetBackendStatus\" class=\"btn btn-outline\"\u003e\n                \u003cspan class=\"btn-icon\"\u003e🔍\u003c/span\u003e Backend Secret (:3000)\n              \u003c/button\u003e\n              \u003cbutton id=\"btnGetLdapStatus\" class=\"btn btn-outline\"\u003e\n                \u003cspan class=\"btn-icon\"\u003e🏢\u003c/span\u003e LDAP Secret (:8000)\n              \u003c/button\u003e\n              \u003cbutton id=\"btnGetData\" class=\"btn btn-primary\"\u003e\n                \u003cspan class=\"btn-icon\"\u003e⚡\u003c/span\u003e GET /api/data\n              \u003c/button\u003e\n              \u003cbutton id=\"btnPostData\" class=\"btn btn-secondary\"\u003e\n                \u003cspan class=\"btn-icon\"\u003e📤\u003c/span\u003e POST /api/data\n              \u003c/button\u003e\n            \u003c/div\u003e\n          \u003c/section\u003e\n\n          \u003c!-- Card 2: Encrypted Database (AES-256) --\u003e\n          \u003csection class=\"card\"\u003e\n            \u003cdiv class=\"card-header\"\u003e\n              \u003cspan class=\"card-tag\"\u003eStatic Encryption\u003c/span\u003e\n              \u003ch2\u003e2. Encrypted Database (AES-256)\u003c/h2\u003e\n            \u003c/div\u003e\n            \u003cp class=\"card-desc\"\u003e\n              Sensitive items are encrypted with \u003ccode\u003eDATABASE_ENCRYPTION_KEY\u003c/code\u003e (which remains permanently static and un-rotated) before writing to disk.\n            \u003c/p\u003e\n\n            \u003cform id=\"encryptForm\" class=\"form-encrypt\"\u003e\n              \u003cdiv class=\"input-group\"\u003e\n                \u003clabel for=\"itemTitle\"\u003eRecord Title / Identifier\u003c/label\u003e\n                \u003cinput type=\"text\" id=\"itemTitle\" placeholder=\"e.g., VPN Credential, Secret Key, Token...\" required /\u003e\n              \u003c/div\u003e\n              \u003cdiv class=\"input-group\"\u003e\n                \u003clabel for=\"itemContent\"\u003eConfidential Payload to Encrypt\u003c/label\u003e\n                \u003ctextarea id=\"itemContent\" rows=\"2\" placeholder=\"e.g., Sensitive payload to store encrypted in DB...\" required\u003e\u003c/textarea\u003e\n              \u003c/div\u003e\n              \u003cdiv class=\"btn-group\"\u003e\n                \u003cbutton type=\"submit\" id=\"btnSaveEncrypted\" class=\"btn btn-accent\"\u003e\n                  \u003cspan class=\"btn-icon\"\u003e🔐\u003c/span\u003e Encrypt \u0026 Store in DB\n                \u003c/button\u003e\n                \u003cbutton type=\"button\" id=\"btnLoadRecords\" class=\"btn btn-outline\"\u003e\n                  \u003cspan class=\"btn-icon\"\u003e📋\u003c/span\u003e Retrieve \u0026 Decrypt Records\n                \u003c/button\u003e\n              \u003c/div\u003e\n            \u003c/form\u003e\n          \u003c/section\u003e\n\n        \u003c/div\u003e\n\n        \u003c!-- Right Column: Live Console \u0026 Decrypted Records --\u003e\n        \u003cdiv class=\"col-console\"\u003e\n          \u003c!-- Terminal / Response viewer --\u003e\n          \u003csection class=\"card console-card\"\u003e\n            \u003cdiv class=\"console-header\"\u003e\n              \u003cdiv class=\"console-dots\"\u003e\n                \u003cspan class=\"dot red\"\u003e\u003c/span\u003e\n                \u003cspan class=\"dot yellow\"\u003e\u003c/span\u003e\n                \u003cspan class=\"dot green\"\u003e\u003c/span\u003e\n              \u003c/div\u003e\n              \u003cspan class=\"console-title\"\u003eLive HTTP Interceptor Console\u003c/span\u003e\n              \u003cbutton id=\"btnClearConsole\" class=\"btn-clear\" title=\"Clear Console\"\u003eClear\u003c/button\u003e\n            \u003c/div\u003e\n            \u003cdiv class=\"console-body\" id=\"consoleOutput\"\u003e\n              \u003cpre\u003e\u003ccode class=\"language-json\"\u003e// Welcome! Authentication successful via LDAP.\n// Click any endpoint button to test real-time requests through NGINX...\u003c/code\u003e\u003c/pre\u003e\n            \u003c/div\u003e\n          \u003c/section\u003e\n\n          \u003c!-- Stored Records Display --\u003e\n          \u003csection class=\"card records-card\"\u003e\n            \u003cdiv class=\"card-header\"\u003e\n              \u003ch2\u003eDecrypted Database Records\u003c/h2\u003e\n              \u003cspan class=\"badge\" id=\"recordCount\"\u003e0 records\u003c/span\u003e\n            \u003c/div\u003e\n            \u003cdiv class=\"records-container\" id=\"recordsList\"\u003e\n              \u003cp class=\"empty-state\"\u003eNo records loaded yet. Click \"Retrieve \u0026 Decrypt Records\".\u003c/p\u003e\n            \u003c/div\u003e\n          \u003c/section\u003e\n        \u003c/div\u003e\n      \u003c/main\u003e\n\n    \u003c/section\u003e\n\n    \u003c!-- FOOTER --\u003e\n    \u003cfooter class=\"footer\"\u003e\n      \u003cp\u003eCybersecurity Lab — LDAP Auth, Zero-Downtime Secret Rotation \u0026 AES-256 Encryption Demo\u003c/p\u003e\n    \u003c/footer\u003e\n\n  \u003c/div\u003e\n\n  \u003cscript src=\"app.js\"\u003e\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n","ip":"172.25.0.6","timestamp":"2026-10-15T23:36:01.29337999Z","curl-command":"curl -X 'GET' -d '' -H 'Accept: */*' -H 'Accept-Language: en' -H 'User-Agent: Mozilla/5.0 (Knoppix; Linux i686) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36' 'http://frontend:80'","matcher-status":true}
{"template":"http/technologies/tech-detect.yaml","template-url":"https://cloud.projectdiscovery.io/public/tech-detect","template-id":"tech-detect","template-path":"/root/nuclei-templates/http/technologies/tech-detect.yaml","info":{"name":"Wappalyzer Technology Detection","author":["hakluke","righettod","matejsmycka"],"tags":["tech","discovery"],"severity":"info","metadata":{"max-request":1}},"matcher-name":"nginx","type":"http","host":"frontend","port":"80","scheme":"http","url":"http://frontend:80","matched-at":"http://frontend:80","request":"GET / HTTP/1.1\r\nHost: frontend\r\nUser-Agent: Mozilla/5.0 (X11; Linux i686; rv:1.9.5.20) Gecko/ Firefox/3.6.16\r\nAccept: */*\r\nAccept-Language: en\r\nAccept-Encoding: gzip\r\n\r\n","response":"HTTP/1.1 200 OK\r\nContent-Length: 9928\r\nAccept-Ranges: bytes\r\nConnection: keep-alive\r\nContent-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'\r\nContent-Type: text/html\r\nCross-Origin-Embedder-Policy: require-corp\r\nCross-Origin-Opener-Policy: same-origin\r\nCross-Origin-Resource-Policy: same-origin\r\nDate: Thu, 15 Oct 2026 23:36:25 GMT\r\nEtag: \"6ad161f1-26c8\"\r\nLast-Modified: Thu, 15 Oct 2026 23:29:53 GMT\r\nPermissions-Policy: camera=(), microphone=(), geolocation=()\r\nReferrer-Policy: no-referrer\r\nServer: nginx\r\nX-Content-Type-Options: nosniff\r\nX-Frame-Options: DENY\r\nX-Permitted-Cross-Domain-Policies: none\r\n\r\n\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n  \u003cmeta charset=\"UTF-8\" /\u003e\n  \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" /\u003e\n  \u003ctitle\u003eCybersecurity Portal: LDAP Authentication \u0026 Hot Secret Rotation\u003c/title\u003e\n  \u003clink rel=\"stylesheet\" href=\"styles.css\" /\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n  \u003cdiv class=\"app-container\"\u003e\n\n    \u003c!-- TOP HEADER --\u003e\n    \u003cheader class=\"header\"\u003e\n      \u003cdiv class=\"header-content\"\u003e\n        \u003cdiv class=\"logo-area\"\u003e\n          \u003cdiv class=\"shield-icon\"\u003e🛡️\u003c/div\u003e\n          \u003cdiv\u003e\n            \u003ch1\u003eSecurity Control \u0026 Secret Rotation Portal\u003c/h1\u003e\n            \u003cp class=\"subtitle\"\u003eOpenLDAP Authentication + 3-Service Dynamic Key Rotation + AES-256 DB Encryption\u003c/p\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"header-right\"\u003e\n          \u003cdiv class=\"status-badge\" id=\"serviceStatus\"\u003e\n            \u003cspan class=\"status-dot\"\u003e\u003c/span\u003e\n            \u003cspan id=\"statusText\"\u003eConnecting...\u003c/span\u003e\n          \u003c/div\u003e\n          \u003cdiv id=\"userProfileBadge\" class=\"user-badge hidden\"\u003e\n            \u003cspan class=\"user-avatar\"\u003e👤\u003c/span\u003e\n            \u003cdiv class=\"user-info\"\u003e\n              \u003cstrong id=\"userDisplayName\"\u003eAlice Smith\u003c/strong\u003e\n              \u003cspan id=\"userDn\"\u003euid=alice,ou=users\u003c/span\u003e\n            \u003c/div\u003e\n            \u003cbutton id=\"btnLogout\" class=\"btn-logout\" title=\"Log Out\"\u003eLogout\u003c/button\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/header\u003e\n\n    \u003c!-- VIEW 1: LANDING PAGE (LOGIN) --\u003e\n    \u003csection id=\"loginView\" class=\"view-section active\"\u003e\n      \u003cdiv class=\"login-wrapper\"\u003e\n        \u003cdiv class=\"login-card\"\u003e\n          \u003cdiv class=\"login-header\"\u003e\n            \u003cdiv class=\"lock-icon\"\u003e🔐\u003c/div\u003e\n            \u003ch2\u003eEnterprise LDAP Authentication\u003c/h2\u003e\n            \u003cp\u003eEnter your corporate LDAP directory credentials to access the secure control center.\u003c/p\u003e\n          \u003c/div\u003e\n\n          \u003cdiv class=\"auth-notice\"\u003e\n            \u003cspan class=\"notice-icon\"\u003e💡\u003c/span\u003e\n            \u003cdiv\u003e\n              \u003cstrong\u003eQuick Demo Credentials:\u003c/strong\u003e\n              \u003cdiv class=\"quick-credentials\"\u003e\n                \u003cbutton type=\"button\" class=\"btn-fill-creds\" data-user=\"alice\" data-pass=\"alice123\"\u003e\n                  User: \u003ccode\u003ealice\u003c/code\u003e / \u003ccode\u003ealice123\u003c/code\u003e\n                \u003c/button\u003e\n                \u003cbutton type=\"button\" class=\"btn-fill-creds\" data-user=\"bob\" data-pass=\"bob123\"\u003e\n                  User: \u003ccode\u003ebob\u003c/code\u003e / \u003ccode\u003ebob123\u003c/code\u003e\n                \u003c/button\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n\n          \u003cform id=\"loginForm\" class=\"login-form\"\u003e\n            \u003cdiv class=\"form-group\"\u003e\n              \u003clabel for=\"usernameInput\"\u003eLDAP Username (UID)\u003c/label\u003e\n              \u003cdiv class=\"input-icon-wrapper\"\u003e\n                \u003cspan class=\"input-icon\"\u003e👤\u003c/span\u003e\n                \u003cinput type=\"text\" id=\"usernameInput\" placeholder=\"e.g., alice or bob\" required autocomplete=\"username\" /\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003cdiv class=\"form-group\"\u003e\n              \u003clabel for=\"passwordInput\"\u003ePassword\u003c/label\u003e\n              \u003cdiv class=\"input-icon-wrapper\"\u003e\n                \u003cspan class=\"input-icon\"\u003e🔑\u003c/span\u003e\n                \u003cinput type=\"password\" id=\"passwordInput\" placeholder=\"••••••••\" required autocomplete=\"current-password\" /\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003cdiv id=\"loginFeedback\" class=\"feedback-box hidden\"\u003e\u003c/div\u003e\n\n            \u003cbutton type=\"submit\" id=\"btnLoginSubmit\" class=\"btn btn-primary btn-block\"\u003e\n              \u003cspan class=\"btn-icon\"\u003e⚡\u003c/span\u003e Authenticate via LDAP\n            \u003c/button\u003e\n          \u003c/form\u003e\n\n          \u003cdiv class=\"login-footer\"\u003e\n            \u003cspan\u003e🔒 Request proxied via NGINX with injected dynamic \u003ccode\u003ex-api-key\u003c/code\u003e to LDAP container (:8000).\u003c/span\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/section\u003e\n\n    \u003c!-- VIEW 2: MAIN DASHBOARD (PROTECTED) --\u003e\n    \u003csection id=\"dashboardView\" class=\"view-section hidden\"\u003e\n      \n      \u003c!-- Multi-Service Architecture Overview Banner --\u003e\n      \u003csection class=\"architecture-card\"\u003e\n        \u003cdiv class=\"arch-col\"\u003e\n          \u003cdiv class=\"arch-pill rotate-pill\"\u003e\n            \u003cspan class=\"pill-icon\"\u003e🔄\u003c/span\u003e\n            \u003cdiv class=\"pill-text\"\u003e\n              \u003cstrong\u003eRotator Daemon\u003c/strong\u003e\n              \u003cspan\u003eUpdates secret every 2m in hot-reload\u003c/span\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"arch-arrow\"\u003e➔\u003c/div\u003e\n        \u003cdiv class=\"arch-col\"\u003e\n          \u003cdiv class=\"arch-pill proxy-pill\"\u003e\n            \u003cspan class=\"pill-icon\"\u003e🌐\u003c/span\u003e\n            \u003cdiv class=\"pill-text\"\u003e\n              \u003cstrong\u003eFrontend NGINX (:8080)\u003c/strong\u003e\n              \u003cspan\u003eInjects dynamic x-api-key\u003c/span\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"arch-arrow\"\u003e➔\u003c/div\u003e\n        \u003cdiv class=\"arch-col\"\u003e\n          \u003cdiv class=\"arch-pill backend-pill\"\u003e\n            \u003cspan class=\"pill-icon\"\u003e⚙️\u003c/span\u003e\n            \u003cdiv class=\"pill-text\"\u003e\n              \u003cstrong\u003eBackend API (:3000)\u003c/strong\u003e\n              \u003cspan\u003eAES-256 DB \u0026 Protected Data\u003c/span\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"arch-arrow\"\u003e+\u003c/div\u003e\n        \u003cdiv class=\"arch-col\"\u003e\n          \u003cdiv class=\"arch-pill ldap-pill\"\u003e\n            \u003cspan class=\"pill-icon\"\u003e🏢\u003c/span\u003e\n            \u003cdiv class=\"pill-text\"\u003e\n              \u003cstrong\u003eLDAP Service (:8000)\u003c/strong\u003e\n              \u003cspan\u003eAuth \u0026 Directory Validation\u003c/span\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/section\u003e\n\n      \u003cmain class=\"grid-main\"\u003e\n        \u003c!-- Left Column: Operations --\u003e\n        \u003cdiv class=\"col-operations\"\u003e\n          \n          \u003c!-- Card 1: 3-Service Rotation Verification --\u003e\n          \u003csection class=\"card\"\u003e\n            \u003cdiv class=\"card-header\"\u003e\n              \u003cspan class=\"card-tag\"\u003e3-Service Verification\u003c/span\u003e\n              \u003ch2\u003e1. Secret Rotation Diagnostics\u003c/h2\u003e\n            \u003c/div\u003e\n            \u003cp class=\"card-desc\"\u003e\n              Validate that the exact same rotated \u003ccode\u003eAPI_SECRET\u003c/code\u003e is actively protecting both the \u003cstrong\u003eBackend API\u003c/strong\u003e and the \u003cstrong\u003eLDAP Service\u003c/strong\u003e without restarting either container.\n            \u003c/p\u003e\n\n            \u003cdiv class=\"btn-grid\"\u003e\n              \u003cbutton id=\"btnGetBackendStatus\" class=\"btn btn-outline\"\u003e\n                \u003cspan class=\"btn-icon\"\u003e🔍\u003c/span\u003e Backend Secret (:3000)\n              \u003c/button\u003e\n              \u003cbutton id=\"btnGetLdapStatus\" class=\"btn btn-outline\"\u003e\n                \u003cspan class=\"btn-icon\"\u003e🏢\u003c/span\u003e LDAP Secret (:8000)\n              \u003c/button\u003e\n              \u003cbutton id=\"btnGetData\" class=\"btn btn-primary\"\u003e\n                \u003cspan class=\"btn-icon\"\u003e⚡\u003c/span\u003e GET /api/data\n              \u003c/button\u003e\n              \u003cbutton id=\"btnPostData\" class=\"btn btn-secondary\"\u003e\n                \u003cspan class=\"btn-icon\"\u003e📤\u003c/span\u003e POST /api/data\n              \u003c/button\u003e\n            \u003c/div\u003e\n          \u003c/section\u003e\n\n          \u003c!-- Card 2: Encrypted Database (AES-256) --\u003e\n          \u003csection class=\"card\"\u003e\n            \u003cdiv class=\"card-header\"\u003e\n              \u003cspan class=\"card-tag\"\u003eStatic Encryption\u003c/span\u003e\n              \u003ch2\u003e2. Encrypted Database (AES-256)\u003c/h2\u003e\n            \u003c/div\u003e\n            \u003cp class=\"card-desc\"\u003e\n              Sensitive items are encrypted with \u003ccode\u003eDATABASE_ENCRYPTION_KEY\u003c/code\u003e (which remains permanently static and un-rotated) before writing to disk.\n            \u003c/p\u003e\n\n            \u003cform id=\"encryptForm\" class=\"form-encrypt\"\u003e\n              \u003cdiv class=\"input-group\"\u003e\n                \u003clabel for=\"itemTitle\"\u003eRecord Title / Identifier\u003c/label\u003e\n                \u003cinput type=\"text\" id=\"itemTitle\" placeholder=\"e.g., VPN Credential, Secret Key, Token...\" required /\u003e\n              \u003c/div\u003e\n              \u003cdiv class=\"input-group\"\u003e\n                \u003clabel for=\"itemContent\"\u003eConfidential Payload to Encrypt\u003c/label\u003e\n                \u003ctextarea id=\"itemContent\" rows=\"2\" placeholder=\"e.g., Sensitive payload to store encrypted in DB...\" required\u003e\u003c/textarea\u003e\n              \u003c/div\u003e\n              \u003cdiv class=\"btn-group\"\u003e\n                \u003cbutton type=\"submit\" id=\"btnSaveEncrypted\" class=\"btn btn-accent\"\u003e\n                  \u003cspan class=\"btn-icon\"\u003e🔐\u003c/span\u003e Encrypt \u0026 Store in DB\n                \u003c/button\u003e\n                \u003cbutton type=\"button\" id=\"btnLoadRecords\" class=\"btn btn-outline\"\u003e\n                  \u003cspan class=\"btn-icon\"\u003e📋\u003c/span\u003e Retrieve \u0026 Decrypt Records\n                \u003c/button\u003e\n              \u003c/div\u003e\n            \u003c/form\u003e\n          \u003c/section\u003e\n\n        \u003c/div\u003e\n\n        \u003c!-- Right Column: Live Console \u0026 Decrypted Records --\u003e\n        \u003cdiv class=\"col-console\"\u003e\n          \u003c!-- Terminal / Response viewer --\u003e\n          \u003csection class=\"card console-card\"\u003e\n            \u003cdiv class=\"console-header\"\u003e\n              \u003cdiv class=\"console-dots\"\u003e\n                \u003cspan class=\"dot red\"\u003e\u003c/span\u003e\n                \u003cspan class=\"dot yellow\"\u003e\u003c/span\u003e\n                \u003cspan class=\"dot green\"\u003e\u003c/span\u003e\n              \u003c/div\u003e\n              \u003cspan class=\"console-title\"\u003eLive HTTP Interceptor Console\u003c/span\u003e\n              \u003cbutton id=\"btnClearConsole\" class=\"btn-clear\" title=\"Clear Console\"\u003eClear\u003c/button\u003e\n            \u003c/div\u003e\n            \u003cdiv class=\"console-body\" id=\"consoleOutput\"\u003e\n              \u003cpre\u003e\u003ccode class=\"language-json\"\u003e// Welcome! Authentication successful via LDAP.\n// Click any endpoint button to test real-time requests through NGINX...\u003c/code\u003e\u003c/pre\u003e\n            \u003c/div\u003e\n          \u003c/section\u003e\n\n          \u003c!-- Stored Records Display --\u003e\n          \u003csection class=\"card records-card\"\u003e\n            \u003cdiv class=\"card-header\"\u003e\n              \u003ch2\u003eDecrypted Database Records\u003c/h2\u003e\n              \u003cspan class=\"badge\" id=\"recordCount\"\u003e0 records\u003c/span\u003e\n            \u003c/div\u003e\n            \u003cdiv class=\"records-container\" id=\"recordsList\"\u003e\n              \u003cp class=\"empty-state\"\u003eNo records loaded yet. Click \"Retrieve \u0026 Decrypt Records\".\u003c/p\u003e\n            \u003c/div\u003e\n          \u003c/section\u003e\n        \u003c/div\u003e\n      \u003c/main\u003e\n\n    \u003c/section\u003e\n\n    \u003c!-- FOOTER --\u003e\n    \u003cfooter class=\"footer\"\u003e\n      \u003cp\u003eCybersecurity Lab — LDAP Auth, Zero-Downtime Secret Rotation \u0026 AES-256 Encryption Demo\u003c/p\u003e\n    \u003c/footer\u003e\n\n  \u003c/div\u003e\n\n  \u003cscript src=\"app.js\"\u003e\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n","ip":"172.25.0.6","timestamp":"2026-10-15T23:36:28.552487262Z","curl-command":"curl -X 'GET' -d '' -H 'Accept: */*' -H 'Accept-Language: en' -H 'User-Agent: Mozilla/5.0 (X11; Linux i686; rv:1.9.5.20) Gecko/ Firefox/3.6.16' 'http://frontend:80'","matcher-status":true}
