server {
    listen 80;
    server_name localhost;

    # Security: Hide NGINX version banner from response headers and error pages
    server_tokens off;

    # Security: Anti-clickjacking and MIME-sniffing headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Static frontend assets
    root /usr/share/nginx/html;
    index index.html;

    # Serve Frontend UI (Landing page & Dashboard)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy to Backend API with secure server-side x-api-key header injection
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Include dynamic header snippet with current rotated secret
        include /etc/nginx/conf.d/api_key_header.conf;
    }

    # Proxy to LDAP Authentication Service with secure server-side x-api-key header injection
    location /ldap/ {
        proxy_pass ${LDAP_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Include dynamic header snippet with current rotated secret
        include /etc/nginx/conf.d/api_key_header.conf;
    }

    # Public health check endpoint
    location /health {
        proxy_pass ${BACKEND_URL}/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
